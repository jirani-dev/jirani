# Copy to .env.local (gitignored) and adjust for your setup.

# Default assumes the full "Run with Docker" stack from
# docs/team/operations.md — nginx on :80 proxying /api/* to the backend.
# Required for protected media (book/audio/video streaming) to work at
# all: those endpoints use nginx's X-Accel-Redirect, which only resolves
# when requests actually pass through nginx.
VITE_API_BASE=http://localhost/api

# If instead you're running the backend directly per operations.md's
# "Run locally (without the backend container)" section (no nginx),
# use this instead. Media streaming won't work in that mode either way.
# VITE_API_BASE=http://localhost:8000
