{
  // Shared project config — portable across machines (macOS, Linux, WSL, Windows).
  // Machine-specific overrides belong in ~/.config/opencode/opencode.json (global),
  // which merges with this file per opencode's precedence rules.
  "$schema": "https://opencode.ai/config.json",
  // Default session model: chat/planning plus direct edits on small tasks
  // (every edit still prompts per the permissions block below). Large/batched
  // work is dispatched to the `executor` subagent (cheaper model); the
  // `review` gate stays on kimi-k3 to match CI's AI_REVIEW_MODEL.
  "model": "opencode-go/qwen3.8-max",
  "default_agent": "build",
  "plugins": [
    // Pinned to superpowers v6.4.1 — minimum tag with V2 defaults, also the
    // latest tag at this pin. Bump deliberately, not on every restart.
    "superpowers@git+https://github.com/obra/superpowers.git#v6.4.1"
    // NOTE: grill-me (LinnetCodes/grill-me, MIT, adapted from Matt Pocock's
    // skills) ships a V1 plugin entrypoint that v2.0.14 rejects
    // (PluginModule.LoadError: missing default export). Its skills are
    // vendored under .opencode/skills/ instead, where OpenCode discovers them
    // natively — no plugin needed. Provides: grill-me, grilling,
    // grill-with-docs, domain-modeling.
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  },
  // Enforces the operating mode declared in AGENTS.md.
  // Prose in AGENTS.md is a request; this block is the actual boundary.
  // NOTE: V2 ordered `permissions[]`. LAST match wins — broad first, narrow last.
  "permissions": [
    // Application source — last match wins.
    { "action": "edit",    "resource": "*",                      "effect": "allow" },
    { "action": "edit",    "resource": "backend/uv.lock",        "effect": "deny" },
    { "action": "edit",    "resource": "backend/alembic.ini",    "effect": "deny" },
    { "action": "edit",    "resource": "backend/migrations/**",  "effect": "deny" },
    { "action": "edit",    "resource": "backend/Dockerfile",     "effect": "deny" },
    { "action": "edit",    "resource": "docker/**",              "effect": "deny" },
    { "action": "edit",    "resource": "docker-compose.yml",     "effect": "deny" },
    { "action": "edit",    "resource": "backend/pyproject.toml", "effect": "deny" },
    { "action": "edit",    "resource": "backend/app/**",         "effect": "ask" },

    { "action": "shell",   "resource": "*",                      "effect": "allow" },
    { "action": "shell",   "resource": "git commit*",            "effect": "ask" },
    { "action": "shell",   "resource": "git push*",              "effect": "ask" },
    { "action": "shell",   "resource": "git reset*",             "effect": "ask" },
    { "action": "shell",   "resource": "git checkout*",          "effect": "ask" },
    { "action": "shell",   "resource": "git switch*",            "effect": "ask" },
    { "action": "shell",   "resource": "git rebase*",            "effect": "ask" },
    { "action": "shell",   "resource": "git merge*",             "effect": "ask" },
    { "action": "shell",   "resource": "git rm*",                "effect": "ask" },
    { "action": "shell",   "resource": "rm *",                   "effect": "ask" },
    { "action": "shell",   "resource": "docker compose down*",   "effect": "ask" },
    { "action": "shell",   "resource": "psql*",                  "effect": "ask" },
    { "action": "shell",   "resource": "uv add*",                "effect": "ask" },
    { "action": "shell",   "resource": "uv remove*",             "effect": "ask" }
  ]
}
