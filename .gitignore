# Byte-compiled / optimized / C extensions
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
.env.*
!.env.example

# Tool caches (ruff/mypy/pytest also self-ignore these; explicit for fresh clones)
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Packaging and coverage artifacts
*.egg-info/
build/
dist/
.coverage
htmlcov/

# OS specific files
.DS_Store
Thumbs.db

# Project specific
uploads/**
backend/uploads/**
*.log
docs/codebase-structure.txt

# Local compose overrides (auto-loaded by docker compose)
docker-compose.override.yml

# JavaScript (the frontend branch, when it merges)
node_modules/

# Generated briefings
todos/

# Generated knowledge graph (regenerate with `graphify update .`)
graphify-out/

backend/data/
